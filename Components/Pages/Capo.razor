@page "/capo"
@rendermode InteractiveServer
@using GuitarChordExplorer.Models
@using GuitarChordExplorer.Services
@inject CapoService CapoService
@inject ChordLibraryService ChordLibraryService

<PageTitle>Capo Calculator - Guitar Theory Lab</PageTitle>

<div class="hero">
    <h1 class="hero-title">Capo Calculator</h1>
    <p class="hero-sub">Pick a key and chord shape - See where to put your capo.</p>
</div>

<div class="controls">
    <label class="control-label" for="keySelect">Key</label>
    <select id="keySelect" class="key-select" @bind="SelectedKey" @bind:after="RefreshCapo">
        <optgroup label="Keys">
            @foreach (var k in CapoService.Chromatic)
            {
                <option value="@k">@k </option>
            }
        </optgroup>
    </select>

    <label class="control-label" for="qualitySelect">Chord Shape</label>
    <select id="qualitySelect" class="key-select" @bind="SelectedQuality" @bind:after="RefreshCapo">
        <option value="@ChordQuality.Major">Major</option>
        <option value="@ChordQuality.Minor">Minor</option>
        <option value="@ChordQuality.Diminished">Diminished</option>
    </select>
</div>

@if (Result != null)
{
    var voicing = ChordLibraryService.GetVoicing(Result.GuitarKey, SelectedQuality);
    var info = new ChordInfo
    {
        Root = Result.GuitarKey,
        Quality = SelectedQuality,
        RomanNumeral = "",
        ScaleDegree = 0
    };

    <div class="result">
        <p>Place capo on fret <strong>@Result.CapoFret</strong></p>
        <p>Use <strong>@Result.GuitarKey</strong> chord shapes</p>
    </div>

    <ChordDiagram Info="info" Voicing="voicing" />
}

@code
{
    private string SelectedKey = "G";
    private ChordQuality SelectedQuality = ChordQuality.Major;
    private CapoInfo? Result;

    protected override void OnInitialized() => RefreshCapo();

    private void RefreshCapo()
    {
        Result = CapoService.GetCapo(SelectedKey);
    }
}
